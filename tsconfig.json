{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "types": [
      "bun-types"
    ]
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    "tests/**/*",
    "electrobun.config.ts",
    "hutch.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".hutch"
  ],
  "extends": "./.hutch/devkit/tsconfig.json"
}
