# Set a password of at least 12 characters before opening /aaaaadmin.
CUBIX_ADMIN_PASSWORD=
# Requests per minute per IP (authentication has stricter limits).
CUBIX_RATE_LIMIT=600
# Comma-separated exact IPs of trusted reverse proxies. Leave empty for direct access.
CUBIX_TRUSTED_PROXIES=
# Official public origin used at build time for SEO. Rebuild after changing it.
CUBIX_PUBLIC_URL=
