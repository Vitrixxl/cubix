# At least 12 characters. Only authorizes mobile APK / OTA uploads (bun run deploy).
# The web administration uses a token: run `cubix-api admin-token` in the container.
CUBIX_ADMIN_PASSWORD=
# The OAuth client ID (Web application) of Google sign-in: public, no secret. Its authorized JavaScript origins:
# the site, http://localhost and http://localhost:5181. Empty: no Google button.
CUBIX_GOOGLE_CLIENT_ID=
# Requests per minute per IP (authentication has stricter limits).
CUBIX_RATE_LIMIT=600
# Comma-separated exact IPs of trusted reverse proxies. Leave empty for direct access.
CUBIX_TRUSTED_PROXIES=
