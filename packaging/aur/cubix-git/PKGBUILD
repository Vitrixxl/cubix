# Maintainer: Vitrixxl <https://github.com/Vitrixxl>
pkgname=cubix-git
pkgver=0.1.0.r0.g916ac85
pkgrel=1
pkgdesc='Native speedcubing timer, algorithm library and trainer'
arch=('x86_64')
url='https://github.com/Vitrixxl/cubix'
# Upstream has not declared a project-wide license; bundled licenses are installed below.
depends=('glibc' 'gcc-libs' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'fontconfig' 'freetype2' 'vulkan-icd-loader')
makedepends=('git' 'rust' 'clang' 'pkgconf' 'unzip' 'desktop-file-utils')
optdepends=('vulkan-driver: GPU rendering' 'xdg-desktop-portal: desktop integration' 'xdg-utils: open external links')
provides=('cubix')
conflicts=('cubix' 'cubix-bin')
_bunver=1.4.0
source=('cubix::git+https://github.com/Vitrixxl/cubix.git#branch=main'
        "bun-linux-x64-${_bunver}.zip::https://github.com/oven-sh/bun/releases/download/bun-v${_bunver}/bun-linux-x64.zip")
sha256sums=('SKIP' '2d03fb5fb83ac8b567aca0a281b2ce1a1a19d488f56c2968d88c3f25e92fe452')
# Cargo strips the native binary; preserve Bun's embedded executable payload.
options=('!lto' '!strip' '!debug')

pkgver() {
  cd "$srcdir/cubix"
  local version
  version=$(sed -n 's/^version = "\([^"]*\)"/\1/p' desktop/Cargo.toml | head -n1)
  printf '%s.r%s.g%s' "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  export PATH="$srcdir/bun-linux-x64:$PATH"
  cd "$srcdir/cubix"
  bun install --frozen-lockfile
  cargo fetch --locked --target x86_64-unknown-linux-gnu --manifest-path desktop/Cargo.toml
}

build() {
  export PATH="$srcdir/bun-linux-x64:$PATH"
  cd "$srcdir/cubix"
  export CARGO_TARGET_DIR="$srcdir/cargo-target"
  export CARGO=cargo
  bun desktop/package.ts
}

check() {
  export PATH="$srcdir/bun-linux-x64:$PATH"
  cd "$srcdir/cubix"
  CUBIX_ENGINE_EXE="$srcdir/cubix/artifacts/gpui/cubix-linux-x64/cubix-engine" bun desktop/engine/smoke.ts
  sed 's|@APP@|/usr/lib/cubix|g' desktop/linux/fr.vitrixxl.cubix.desktop > "$srcdir/cubix.desktop"
  desktop-file-validate "$srcdir/cubix.desktop"
}

package() {
  cd "$srcdir/cubix"
  local bundle=artifacts/gpui/cubix-linux-x64
  install -d "$pkgdir/usr/lib/cubix" "$pkgdir/usr/bin" "$pkgdir/usr/share/licenses/$pkgname"
  install -m755 "$bundle/cubix-desktop" "$bundle/cubix-engine" "$pkgdir/usr/lib/cubix/"
  cp -r "$bundle/assets" "$bundle/vendor" "$pkgdir/usr/lib/cubix/"
  cp -r "$bundle/licenses/." "$pkgdir/usr/share/licenses/$pkgname/"
  install -m644 "$bundle/NOTICE" "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  install -m644 "$bundle/assets/fonts/OFL.txt" "$pkgdir/usr/share/licenses/$pkgname/Geist-OFL.txt"
  ln -s /usr/lib/cubix/cubix-desktop "$pkgdir/usr/bin/cubix"
  sed 's|@APP@|/usr/lib/cubix|g' desktop/linux/fr.vitrixxl.cubix.desktop > "$srcdir/cubix.desktop"
  install -Dm644 "$srcdir/cubix.desktop" "$pkgdir/usr/share/applications/fr.vitrixxl.cubix.desktop"
  install -Dm644 desktop/linux/fr.vitrixxl.cubix.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/fr.vitrixxl.cubix.png"
}
