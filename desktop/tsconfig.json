{
  "extends": "../tsconfig.json",
  "include": [
    "*.ts",
    "engine/*.ts",
    "electron/*.ts",
    "scripts/*.tsx",
    "testing/*.ts",
    "tests/*.ts",
    "guides/*.ts",
    "guides/*.tsx",
    "renderer/**/*.ts",
    "renderer/**/*.tsx"
  ],
  "exclude": [
    "assets",
    "dist"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "renderer/*"
      ]
    }
  }
}
