{
  "name": "cubix-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "sh -c \". scripts/env.sh && expo run:android\"",
    "typecheck": "tsc --noEmit",
    "build:scrambler": "bun scripts/build-scrambler.ts",
    "build:cases": "bun scripts/build-cases.ts",
    "prebuild": "expo prebuild --platform android",
    "apk": "bun scripts/build-apk.ts",
    "postinstall": "bun scripts/build-scrambler.ts && bun scripts/build-cases.ts",
    "pc": "bun scripts/run-android.ts",
    "serve:apk": "bun scripts/serve-apk.ts",
    "doctor": "bunx expo-doctor",
    "test": "bun test tests && bun test ./scripts/daily-learning.test.tsx && bun test ./scripts/learning-groups.test.tsx && bun test ./scripts/startup-gate.test.tsx",
    "test:scrambler": "bun run build:scrambler && bun scripts/test-scrambler.ts"
  },
  "dependencies": {
    "expo": "~57.0.22",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-navigation-bar": "~57.0.2",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.22",
    "jotai": "^3.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-mmkv": "^4.3.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.3.0",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.2.3",
    "svgo": "^4.1.0",
    "typescript": "~6.0.3"
  }
}
