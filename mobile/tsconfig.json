{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "react-native",
      "bun"
    ]
  },
  "include": [
    "index.ts",
    "App.tsx",
    "app.config.ts",
    "src/**/*",
    "scripts/**/*",
    "../src/shared/**/*",
    "../src/client/local/**/*",
    "../src/client/api-client.ts",
    "../src/client/lib/**/*"
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios"
  ]
}
