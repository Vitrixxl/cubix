{
  "name": "cubix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sh desktop/run.sh",
    "build": "bun desktop/package.ts",
    "build:api": "sh scripts/rust.sh build --release --locked",
    "start": "sh scripts/rust.sh serve",
    "typecheck": "tsc --noEmit && tsc --noEmit -p desktop",
    "test": "bun run build:api && bun test --timeout 15000 ./tests && bun scripts/test-cube.ts && sh scripts/rust.sh test --locked",
    "test:api": "bun run build:api && bun test --timeout 15000 ./tests/accounts.test.ts ./tests/api-client.test.ts ./tests/rust-api.test.ts ./tests/admin.test.ts ./tests/api-only.test.ts",
    "build:db": "tsx scripts/build-db.ts",
    "build:catalog": "bun scripts/build-cube-catalog.ts && bun scripts/build-niche-catalog.ts && bun scripts/build-catalog.ts",
    "import:history": "sh scripts/rust.sh serve --import-history",
    "launch": "sh desktop/run.sh",
    "stress": "tsx scripts/stress-api.ts",
    "mobile": "bun run --cwd mobile pc",
    "build:android": "bun run --cwd mobile apk",
    "deploy": "bun scripts/deploy.ts",
    "dev:api": "bun run build:api && bun run start",
    "build:desktop": "bun desktop/package.ts",
    "build:assets": "bun desktop/scripts/export-assets.tsx",
    "test:desktop": "bun desktop/engine/build.ts && bun desktop/engine/smoke.ts"
  },
  "dependencies": {
    "@cubing/icons": "^3.0.5",
    "cubing": "^0.63.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5",
    "ws": "^8.0.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
