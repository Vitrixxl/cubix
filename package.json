{
  "name": "cubix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "build:api": "sh scripts/rust.sh build --release --locked",
    "start": "sh scripts/rust.sh serve",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:api && vitest run && tsx scripts/test-cube.ts && sh scripts/rust.sh test --locked",
    "test:api": "npm run build:api && vitest run tests/accounts.test.ts tests/social.test.ts tests/api-client.test.ts tests/rust-api.test.ts",
    "build:db": "tsx scripts/build-db.ts",
    "import:history": "sh scripts/rust.sh serve --import-history",
    "launch": "sh scripts/cubix-launch.sh",
    "stress": "tsx scripts/stress-api.ts"
  },
  "dependencies": {
    "cubing": "^0.63.4",
    "jotai": "^2.20.3",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "^5",
    "@types/node": "^24.0.0",
    "vite": "^8.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "vitest": "^4.0.0",
    "tsx": "^4.0.0",
    "ws": "^8.0.0",
    "@types/ws": "^8.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
