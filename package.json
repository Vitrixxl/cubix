{
  "name": "cubix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun desktop/dev.ts",
    "dev:web": "bun desktop/dev.ts --web",
    "dev:docker": "bun scripts/dev-docker.ts",
    "dev:api": "bun run build:api && bun run start",
    "start": "sh scripts/rust.sh serve",
    "build:api": "sh scripts/rust.sh build --release --locked",
    "build:web": "bun desktop/web.ts",
    "build:desktop": "bun desktop/package.ts",
    "build:android": "bun run --cwd mobile apk",
    "build:assets": "bun desktop/scripts/export-assets.tsx",
    "build:catalog": "bun scripts/build-cube-catalog.ts && bun scripts/build-niche-catalog.ts && bun scripts/build-case-images.ts && bun scripts/build-catalog.ts",
    "build:db": "tsx scripts/build-db.ts",
    "mobile": "bun run --cwd mobile pc",
    "deploy": "bun scripts/deploy.ts",
    "deploy:bg": "bun scripts/deploy-background.ts",
    "import:history": "sh scripts/rust.sh serve --import-history",
    "stress": "tsx scripts/stress-api.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p desktop && bun run --cwd mobile typecheck",
    "test": "bun run build:api && bun test --timeout 15000 ./tests ./desktop/tests && bun scripts/test-cube.ts && sh scripts/rust.sh test --locked --features seed",
    "test:api": "bun run build:api && bun test --timeout 15000 ./tests/accounts.test.ts ./tests/api-client.test.ts ./tests/rust-api.test.ts ./tests/admin.test.ts ./tests/api-only.test.ts",
    "test:ui": "bun run build:api && bun desktop/build.ts && bun desktop/web.ts && bun desktop/testing/web-app.ts && bun desktop/testing/responsive.ts && bun desktop/testing/history-chart.ts && bun desktop/testing/error-notification.ts && bun desktop/testing/introduction.ts && bun desktop/testing/prerender.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tailwindcss/node": "4.1.14",
    "@tailwindcss/oxide": "4.1.14",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "cubing": "^0.63.4",
    "lucide-react": "^1.49.0",
    "motion": "^13.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19",
    "react-router": "^8.4.0",
    "recharts": "3.8.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.4.3",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "tsx": "^4.0.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "trustedDependencies": [
    "electron"
  ]
}
