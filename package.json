{
  "name": "cubix",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "hutch run dev",
    "start": "hutch run start",
    "build": "hutch run build",
    "dev:web": "bun run scripts/dev-web.ts",
    "build:view": "bun run scripts/build-view.ts",
    "build:db": "bun run scripts/build-db.ts",
    "test": "bun run scripts/test-cube.ts && bun run test:accounts",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "serve": "bun run scripts/serve.ts",
    "launch": "sh scripts/cubix-launch.sh",
    "test:accounts": "bun test tests/accounts.test.ts",
    "import:history": "bun run scripts/import-history.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "cubing": "^0.63.4",
    "elysia": "^1.4.30",
    "jotai": "^2.20.3",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "^5"
  }
}
